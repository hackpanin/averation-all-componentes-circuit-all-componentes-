averation all componentes batery const int INPUT_PIN = A0;
const int DIGITAL_PIN = 2;

// Tiempo mínimo de calentamiento (milisegundos)
// Hoja de datos: >= 20 segundos (recomendado más tiempo para estabilidad)
const unsigned long WARMUP_TIME = 20000;

void setup() {
  Serial.begin(9600);
  pinMode(DIGITAL_PIN, INPUT);

  Serial.println("MQ-2 Gas Sensor Initializing...");
  Serial.println("Warming up sensor (minimum 20 seconds)...");

  unsigned long startTime = millis();

  // Bucle de calentamiento con retroalimentación de progreso
  while (millis() - startTime < WARMUP_TIME) {
    unsigned long elapsed = (millis() - startTime) / 1000;
    Serial.print("Warm-up: ");
    Serial.print(elapsed);
    Serial.println(" s");
    delay(1000);
  }

  Serial.println("Warm-up complete. Sensor readings are now more stable.");
  Serial.println("NOTE: Full calibration may require 2–5 minutes.");
  Serial.println();
}

void loop() {
  // Leer valor analógico (0–1023)
  int analogValue = analogRead(INPUT_PIN);

  // Convertir lectura ADC a voltaje (asumiendo referencia de 5V)
  float voltage = analogValue * (5.0 / 1023.0);

  // Leer salida de umbral digital
  int digitalValue = digitalRead(DIGITAL_PIN);

  Serial.print("Gas value (ADC): ");
  Serial.print(analogValue);
  Serial.print("  Voltage: ");
  Serial.print(voltage, 2);
  Serial.print(" V  |  D0: ");

  if (digitalValue == HIGH) {
    Serial.println("Gas detected! (threshold exceeded)");
  } else {
    Serial.println("Normal");
  }

  // Verificación de umbral por software (ajustar según sea necesario)
  if (analogValue > 300) {
    Serial.println("WARNING: High gas concentration detected!");
  }

  Serial.println();

  delay(1000);
}
